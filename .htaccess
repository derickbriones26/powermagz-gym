<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Set the base directory (adjust if your app is in a subfolder, but for Render it's usually just /)
    RewriteBase /

    # 1. If the request is for an actual file (like index.php, css, images), serve it directly.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 2. If the request is for router.php, serve it directly (to prevent loops if it exists)
    RewriteRule ^router\.php$ - [L]

    # 3. Otherwise, rewrite EVERYTHING to index.php
    RewriteRule ^ index.php [L,QSA]
</IfModule>